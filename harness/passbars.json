// Pass bars from the design spec's Stage 0 scoring table. The report marks each metric pass or fail against these.
// Latency bars apply to local tiers only (the spec measures them on the reference GPU).
// Invented facts are split by the judge: major = a new person, place, number, quote or event, a character put at a
// past event, or a contradiction, held to the spec's bar. Minor ones (an added cause or status, old news told as new)
// are reported but have no bar: dropped 2026-11-21, because the count depends heavily on the judge model (Sonnet 5.5
// counts about twice what Opus 5.5 did) and even the Claude reference scored 28 per 10.
{
  "director": {
    "jsonValidGrammarOn": 1.0,
    "jsonValidGrammarOff": 0.95,
    "choiceAllowed": 1.0,
    "medianLatencySeconds": 10,
    "latencyTiers": ["Minimum", "Recommended", "High"]
  },
  "news-bulletin": {
    "majorInventedPer10": 1.0,
    "overall": 3.5,
    "overallTiers": ["Recommended"],
    "lengthOk": 0.9,
    "medianLatencySeconds": 20,
    "latencyTiers": ["Minimum", "Recommended", "High"]
  },
  "inheritance-handoff": {
    "majorInventedPer10": 1.0,
    "overall": 3.5,
    "overallTiers": ["Recommended"],
    "lengthOk": 0.9
  }
}
