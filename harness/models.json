// Stage 0 candidate models. Adding a model is a config change only.
// Keys come from environment variables (apiKeyEnv), never this file.
//
// Thinking is Off for every task on the local models: the prompts' token caps are sized for the answer alone,
// and the game can't wait for long reasoning. Ollama's OpenAI-compatible endpoint ignores {"think": false};
// it takes "reasoning_effort": "none". (llama.cpp takes {"chat_template_kwargs": {"enable_thinking": false}}.)
// `check` warns when a model still thinks with thinking Off.
//
// Raon-1 nano is left out of the current evaluation (decided 2026-11-20). To test it later, set up its server
// (docs/local-setup.md, "Later: Raon-1 nano") and add this entry back to "models":
//   { "id": "raon-1-nano", "tier": "Minimum", "provider": "OpenAi",
//     "endpoint": "http://localhost:8081", "model": "raon-1-nano", "supportsGrammar": true },
{
  "repeats": 3,
  "models": [
    {
      "id": "qwen3.5-2b", "tier": "Minimum", "provider": "OpenAi",
      "endpoint": "http://localhost:11434", "model": "qwen3.5:2b",
      "thinking": "Off", "thinkingOffBody": { "reasoning_effort": "none" }
    },
    {
      "id": "gemma4-e2b", "tier": "Minimum", "provider": "OpenAi",
      "endpoint": "http://localhost:11434", "model": "gemma4:e2b",
      "thinking": "Off", "thinkingOffBody": { "reasoning_effort": "none" }
    },
    {
      "id": "qwen3.5-4b", "tier": "Recommended", "provider": "OpenAi",
      "endpoint": "http://localhost:11434", "model": "qwen3.5:4b",
      "thinking": "Off", "thinkingOffBody": { "reasoning_effort": "none" }
    },
    {
      "id": "gemma4-e4b", "tier": "Recommended", "provider": "OpenAi",
      "endpoint": "http://localhost:11434", "model": "gemma4:e4b",
      "thinking": "Off", "thinkingOffBody": { "reasoning_effort": "none" }
    },
    {
      "id": "gemma4-12b", "tier": "High", "provider": "OpenAi",
      "endpoint": "http://localhost:11434", "model": "gemma4:12b",
      "thinking": "Off", "thinkingOffBody": { "reasoning_effort": "none" }
    },
    {
      "id": "qwen3-14b", "tier": "High", "provider": "OpenAi",
      "endpoint": "http://localhost:11434", "model": "qwen3:14b",
      "thinking": "Off", "thinkingOffBody": { "reasoning_effort": "none" }
    },
    {
      "id": "claude-ref", "tier": "Reference", "provider": "Anthropic",
      "model": "claude-opus-5-5", "apiKeyEnv": "RIMCHRONICLES_ANTHROPIC_API_KEY",
      "effort": "medium", "thinkingByTask": { "director": "Off" },
      "concurrency": 4, "timeoutSeconds": 300
    }
  ],
  "judge": {
    "id": "judge", "tier": "Reference", "provider": "Anthropic",
    "model": "claude-opus-5-5", "apiKeyEnv": "RIMCHRONICLES_ANTHROPIC_API_KEY",
    "effort": "medium", "concurrency": 4, "timeoutSeconds": 300
  }
}
