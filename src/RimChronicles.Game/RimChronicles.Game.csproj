<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Engine adapter, Harmony patches, GameComponent, letters and UI. The only project that references RimWorld.
    RimWorld and Harmony 3 assemblies are referenced from the local install (never copied, never bundled).
    Without RimWorldManagedDir set (see Directory.Build.props.user.example) the project compiles no sources,
    so the solution still builds in CI.
  -->
  <PropertyGroup>
    <RimWorldAvailable Condition="'$(RimWorldManagedDir)' != '' And Exists('$(RimWorldManagedDir)')">true</RimWorldAvailable>
    <EnableDefaultCompileItems Condition="'$(RimWorldAvailable)' != 'true'">false</EnableDefaultCompileItems>
    <ModOutputDir>$(RepoRoot)1.7\Assemblies\</ModOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RimChronicles.Llm\RimChronicles.Llm.csproj" />
    <ProjectReference Include="..\RimChronicles.Core\RimChronicles.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(RimWorldAvailable)' == 'true'">
    <Reference Include="$(RimWorldManagedDir)\Assembly-CSharp.dll" Private="false" />
    <!-- UnityStubs only for UI code (Rect in settings and windows); everything else avoids Unity types (rule 3). -->
    <Reference Include="$(RimWorldManagedDir)\UnityStubs.dll" Private="false" />
    <Reference Include="$(HarmonyAssembliesDir)\0Harmony.dll" Private="false" Condition="'$(HarmonyAssembliesDir)' != ''" />
  </ItemGroup>

  <Target Name="ReportRimWorldMissing" BeforeTargets="Build" Condition="'$(RimWorldAvailable)' != 'true'">
    <Message Importance="high" Text="RimChronicles.Game: RimWorldManagedDir not set or not found; building without game sources." />
  </Target>

  <!-- Copy mod DLLs (Llm, Core, Game) into the RimWorld per-version folder. Harmony and game DLLs are excluded. -->
  <Target Name="CopyToModFolder" AfterTargets="Build" Condition="'$(RimWorldAvailable)' == 'true'">
    <ItemGroup>
      <ModAssemblies Include="$(OutDir)RimChronicles.*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ModAssemblies)" DestinationFolder="$(ModOutputDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    The Workshop folder: only what the game loads, nothing from src/, harness/, training/, docs/ or results/.
      dotnet build src/RimChronicles.Game -c Release -t:PackageRelease
    writes release/RimChronicles/ (git-ignored). Copy that folder into RimWorld's Mods folder to test it or upload it.
    docs/release.md has the whole release checklist.
  -->
  <Target Name="PackageRelease" DependsOnTargets="Build">
    <Error Condition="'$(RimWorldAvailable)' != 'true'" Text="PackageRelease needs RimWorldManagedDir (Directory.Build.props.user): without it the mod DLL is empty." />
    <Error Condition="'$(Configuration)' != 'Release'" Text="Package a Release build: add -c Release." />
    <Warning Condition="!Exists('$(RepoRoot)About\Preview.png')" Text="About/Preview.png is missing: the Workshop page needs a preview image." />
    <PropertyGroup>
      <PackageDir>$(RepoRoot)release\RimChronicles\</PackageDir>
    </PropertyGroup>
    <ItemGroup>
      <PackageAbout Include="$(RepoRoot)About\**\*" />
      <PackageDefs Include="$(RepoRoot)Defs\**\*" />
      <PackagePrompts Include="$(RepoRoot)prompts\**\*" />
      <PackageAssemblies Include="$(OutDir)RimChronicles.Llm.dll;$(OutDir)RimChronicles.Core.dll;$(OutDir)RimChronicles.Game.dll" />
      <PackageRoot Include="$(RepoRoot)LICENSE;$(RepoRoot)README.md" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageDir)" />
    <Copy SourceFiles="@(PackageAbout)" DestinationFiles="@(PackageAbout->'$(PackageDir)About\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(PackageDefs)" DestinationFiles="@(PackageDefs->'$(PackageDir)Defs\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(PackagePrompts)" DestinationFiles="@(PackagePrompts->'$(PackageDir)prompts\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(PackageAssemblies)" DestinationFolder="$(PackageDir)1.7\Assemblies\" />
    <Copy SourceFiles="@(PackageRoot)" DestinationFolder="$(PackageDir)" />
    <Message Importance="high" Text="Rim Chronicles packaged in $(PackageDir)" />
  </Target>
</Project>
