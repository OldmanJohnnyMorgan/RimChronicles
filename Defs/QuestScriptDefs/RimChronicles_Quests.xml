<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Rim Chronicles quests are started by plots only: randomlySelectable is false and rootSelectionWeight stays 0, so
       the storyteller never picks them on its own. isRootSpecial marks them as roots started from code, which RimWorld
       requires for defaultChallengeRating; their roots refuse to run without a plot, so the vanilla Dev Mode quest
       menus skip them. -->
  <QuestScriptDef>
    <defName>RimChronicles_Test</defName>
    <randomlySelectable>false</randomlySelectable>
    <isRootSpecial>true</isRootSpecial>
    <autoAccept>false</autoAccept>
    <expireDaysRange>1~1</expireDaysRange>
    <defaultChallengeRating>1</defaultChallengeRating>
    <root Class="RimChronicles.Game.Quests.QuestNode_Root_ChroniclesTest" />
  </QuestScriptDef>
  <QuestScriptDef>
    <defName>RimChronicles_Hunt</defName>
    <randomlySelectable>false</randomlySelectable>
    <isRootSpecial>true</isRootSpecial>
    <autoAccept>false</autoAccept>
    <expireDaysRange>4~4</expireDaysRange>
    <defaultChallengeRating>2</defaultChallengeRating>
    <root Class="RimChronicles.Game.Quests.QuestNode_Root_ChroniclesHunt" />
  </QuestScriptDef>
  <QuestScriptDef>
    <defName>RimChronicles_Rescue</defName>
    <randomlySelectable>false</randomlySelectable>
    <isRootSpecial>true</isRootSpecial>
    <autoAccept>false</autoAccept>
    <expireDaysRange>4~4</expireDaysRange>
    <defaultChallengeRating>2</defaultChallengeRating>
    <root Class="RimChronicles.Game.Quests.QuestNode_Root_ChroniclesRescue" />
  </QuestScriptDef>
  <QuestScriptDef>
    <defName>RimChronicles_Deliver</defName>
    <randomlySelectable>false</randomlySelectable>
    <isRootSpecial>true</isRootSpecial>
    <autoAccept>false</autoAccept>
    <expireDaysRange>4~4</expireDaysRange>
    <defaultChallengeRating>1</defaultChallengeRating>
    <root Class="RimChronicles.Game.Quests.QuestNode_Root_ChroniclesDeliver" />
  </QuestScriptDef>
  <QuestScriptDef>
    <defName>RimChronicles_Escort</defName>
    <randomlySelectable>false</randomlySelectable>
    <isRootSpecial>true</isRootSpecial>
    <autoAccept>false</autoAccept>
    <expireDaysRange>4~4</expireDaysRange>
    <defaultChallengeRating>1</defaultChallengeRating>
    <root Class="RimChronicles.Game.Quests.QuestNode_Root_ChroniclesEscort" />
  </QuestScriptDef>
  <QuestScriptDef>
    <defName>RimChronicles_DefendAlly</defName>
    <randomlySelectable>false</randomlySelectable>
    <isRootSpecial>true</isRootSpecial>
    <autoAccept>false</autoAccept>
    <expireDaysRange>4~4</expireDaysRange>
    <defaultChallengeRating>2</defaultChallengeRating>
    <root Class="RimChronicles.Game.Quests.QuestNode_Root_ChroniclesDefendAlly" />
  </QuestScriptDef>
  <QuestScriptDef>
    <defName>RimChronicles_Sabotage</defName>
    <randomlySelectable>false</randomlySelectable>
    <isRootSpecial>true</isRootSpecial>
    <autoAccept>false</autoAccept>
    <expireDaysRange>4~4</expireDaysRange>
    <defaultChallengeRating>2</defaultChallengeRating>
    <root Class="RimChronicles.Game.Quests.QuestNode_Root_ChroniclesSabotage" />
  </QuestScriptDef>
  <!-- An Imperial site to destroy (crisis C9): offered by the Empire plot's SabotageImperial job. Needs Royalty. -->
  <QuestScriptDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>RimChronicles_ImperialSite</defName>
    <randomlySelectable>false</randomlySelectable>
    <isRootSpecial>true</isRootSpecial>
    <autoAccept>false</autoAccept>
    <expireDaysRange>4~4</expireDaysRange>
    <defaultChallengeRating>3</defaultChallengeRating>
    <root Class="RimChronicles.Game.Crisis.Sites.QuestNode_Root_ChroniclesImperialSite" />
  </QuestScriptDef>
  <!-- A summons (War in Heaven W6, spec §6.1): the colony's side sends a shuttle for a colonist of the kind it can't keep,
       holds them 5 days and returns them converted. Started by the summons driver, never by the storyteller. Needs
       Royalty (the shuttle) and Biotech (mechlinks). -->
  <QuestScriptDef MayRequire="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Biotech">
    <defName>RimChronicles_Summons</defName>
    <randomlySelectable>false</randomlySelectable>
    <isRootSpecial>true</isRootSpecial>
    <autoAccept>false</autoAccept>
    <expireDaysRange>3~3</expireDaysRange>
    <root Class="RimChronicles.Game.Powers.QuestNode_Root_ChroniclesSummons" />
  </QuestScriptDef>

</Defs>
