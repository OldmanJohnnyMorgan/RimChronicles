// Stage 0 candidate models. Adding a model is a config change only.
// Keys come from environment variables (apiKeyEnv), never this file.
//
// Thinking is Off for every task on the local models: the prompts' token caps are sized for the answer alone,
// and the game can't wait for long reasoning. Ollama's OpenAI-compatible endpoint ignores {"think": false};
// it takes "reasoning_effort": "none". (llama.cpp takes {"chat_template_kwargs": {"enable_thinking": false}}.)
// `check` warns when a model still thinks with thinking Off.
//
// Local models sample at temperature 0.4: the server defaults (about 0.6-1.0) encouraged invented detail in
// bulletins. `run --temperature default` drops the setting to compare against the server default.
//
// Raon-1 nano was dropped on 2026-11-21 (Stage 0 closed with the Gemma models; see docs/stage0-results.md):
// it runs only on Krafton's llama.cpp fork, which is too much setup to ask of players.
//
// The Qwen models (qwen3.5:2b, qwen3.5:4b, qwen3:14b) were dropped on 2026-11-21: across four bulletin prompt
// versions they invented major facts at 10-37 per 10 bulletins, against 2-3 for the Gemma models. Each entry was
//   { "id": "qwen3.5-4b", "tier": "Recommended", "provider": "OpenAi", "endpoint": "http://localhost:11434",
//     "model": "qwen3.5:4b", "thinking": "Off", "thinkingOffBody": { "reasoning_effort": "none" },
//     "extraBody": { "temperature": 0.4 } },
//
// The judge moved from Opus 5.5 to Sonnet 5.5 on 2026-11-21 to cut cost. On run 20261121-112244 (judge v3, 194
// outputs) Sonnet matched Opus on overall score 82% of the time (same mean, 2.82) and flagged 20 of Opus's 25
// outputs with a major invented fact; Haiku 5.5 matched 61% and flagged 12, so it was not used. Only compare runs
// scored by the same judge model. Prompt rounds leave out claude-ref (see docs/stage0-runbook.md).
{
  "repeats": 3,
  "models": [
    {
      "id": "gemma4-e2b", "tier": "Minimum", "provider": "OpenAi",
      "endpoint": "http://localhost:11434", "model": "gemma4:e2b",
      "thinking": "Off", "thinkingOffBody": { "reasoning_effort": "none" },
      "extraBody": { "temperature": 0.4 }
    },
    {
      "id": "gemma4-e4b", "tier": "Recommended", "provider": "OpenAi",
      "endpoint": "http://localhost:11434", "model": "gemma4:e4b",
      "thinking": "Off", "thinkingOffBody": { "reasoning_effort": "none" },
      "extraBody": { "temperature": 0.4 }
    },
    {
      "id": "gemma4-12b", "tier": "High", "provider": "OpenAi",
      "endpoint": "http://localhost:11434", "model": "gemma4:12b",
      "thinking": "Off", "thinkingOffBody": { "reasoning_effort": "none" },
      "extraBody": { "temperature": 0.4 }
    },
    {
      "id": "claude-ref", "tier": "Reference", "provider": "Anthropic",
      "model": "claude-opus-5-5", "apiKeyEnv": "RIMCHRONICLES_ANTHROPIC_API_KEY",
      "effort": "medium", "thinkingByTask": { "director": "Off" },
      "concurrency": 4, "timeoutSeconds": 300
    }
  ],
  "judge": {
    "id": "judge", "tier": "Reference", "provider": "Anthropic",
    "model": "claude-sonnet-5-5", "apiKeyEnv": "RIMCHRONICLES_ANTHROPIC_API_KEY",
    "effort": "medium", "concurrency": 4, "timeoutSeconds": 300
  }
}
