<Project>
  <!--
    Copy to Directory.Build.props.user (untracked) and point these at your RimWorld 1.7 install.
    Without them, RimChronicles.Game builds as an empty assembly and everything else works as normal.
    On 1.7 (Waylith) the game DLLs sit in the RimWorld folder itself, not under RimWorldWin64_Data\Managed.
  -->
  <PropertyGroup>
    <RimWorldManagedDir>D:\SteamLibrary\steamapps\common\RimWorld</RimWorldManagedDir>
    <!-- Harmony 3 Workshop mod (2009463077), its 1.7 folder. -->
    <HarmonyAssembliesDir>D:\SteamLibrary\steamapps\workshop\content\294100\2009463077\1.7\Assemblies</HarmonyAssembliesDir>
  </PropertyGroup>
</Project>
