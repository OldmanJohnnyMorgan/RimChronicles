<?xml version="1.0" encoding="utf-8"?>
<!--
  Psyker scorers (crisis spec §5.3.1, C4): each turns on one scorer (an IPsycastScorer id in
  src/RimChronicles.Core/Crisis/Psykers/Scorers.cs) for the psycasts listed. A psycast with no scorer here is never cast by
  a crisis unit. A scorer whose psycasts are missing is turned off and logged at startup. Farskip has none until C13.
-->
