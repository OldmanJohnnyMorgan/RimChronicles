<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThoughtDef>
    <defName>RimChronicles_NemesisAvenged</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>30</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>avenged</label>
        <description>The raider who wronged us is dead, and it was our hand that did it.</description>
        <baseMoodEffect>10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RimChronicles_NemesisSettled</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>20</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>score settled</label>
        <description>The raider who wronged us can't hurt anyone now. It wasn't my hand, but it's over.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RimChronicles_NemesisEscaped</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>nemesis escaped</label>
        <description>The raider who wronged us got away for good. Somewhere out there, they're still laughing.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RimChronicles_FamilyReunited</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>30</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>family reunited</label>
        <description>Family I thought I might never see again is here, safe, under the same roof.</description>
        <baseMoodEffect>12</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RimChronicles_FamilyLost</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>20</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>family lost</label>
        <description>They were taken, and we didn't bring them back. I keep their letters.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
