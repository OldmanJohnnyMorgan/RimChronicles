          <li>(0,5,6,5)</li>
          <li>(0,1,0,4)</li>
          <li>(6,1,6,4)</li>
        </rects>
      </Wall>
      <Door>
        <position>(3, 0, 0)</position>
      </Door>
      <Bed>
        <positions>
          <li>(1, 0, 3)</li>
          <li>(3, 0, 3)</li>
          <li>(5, 0, 3)</li>
        </positions>
      </Bed>
      <TorchLamp>
        <position>(1, 0, 1)</position>
      </TorchLamp>
    </things>
    <modExtensions>
      <li Class="RimChronicles.Game.Crisis.Pieces.PieceExtension">
        <tags><li>Room</li><li>Barracks</li></tags>
        <doorSides><li>South</li></doorSides>
        <buildOrder>1</buildOrder>
      </li>
    </modExtensions>
  </PrefabDef>

