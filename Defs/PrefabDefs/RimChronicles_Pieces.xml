        <rects>
          <li>(0,4,4,4)</li>
          <li>(0,1,0,3)</li>
          <li>(4,1,4,3)</li>
          <li>(0,0,1,0)</li>
          <li>(3,0,4,0)</li>
        </rects>
      </Sandbags>
      <Turret_Mortar>
        <position>(2, 0, 2)</position>
      </Turret_Mortar>
    </things>
    <modExtensions>
      <li Class="RimChronicles.Game.Crisis.Pieces.PieceExtension">
        <power>empire</power>
        <tags><li>Emplacement</li><li>Artillery</li></tags>
        <doorSides><li>South</li></doorSides>
        <defenseValue>3</defenseValue>
        <threatCost>120</threatCost>
        <buildOrder>2</buildOrder>
      </li>
    </modExtensions>
  </PrefabDef>

  <PrefabDef>
    <defName>RimChronicles_Piece_TurretNest</defName>
    <size>(5,5)</size>
    <things>
      <Sandbags>
        <rects>
          <li>(0,4,4,4)</li>
          <li>(0,1,0,3)</li>
          <li>(4,1,4,3)</li>
          <li>(0,0,1,0)</li>
          <li>(3,0,4,0)</li>
        </rects>
      </Sandbags>
      <Turret_MiniTurret>
        <position>(2, 0, 2)</position>
      </Turret_MiniTurret>
    </things>
    <modExtensions>
      <li Class="RimChronicles.Game.Crisis.Pieces.PieceExtension">
